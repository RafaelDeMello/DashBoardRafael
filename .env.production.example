# Copie para .env.production NA VPS e preencha. NUNCA vai para o git.
# Gere a senha do banco com:  openssl rand -hex 24

# Banco de dados
POSTGRES_USER=onlytasks
POSTGRES_PASSWORD=troque-por-uma-senha-longa-e-aleatoria
POSTGRES_DB=onlytasks

# Endereço do site. Com um domínio, o HTTPS é automático (o DNS precisa apontar para a VPS).
SITE_ADDRESS=meusite.com.br

# Portas expostas na VPS (o normal é 80 e 443)
HTTP_PORT=80
HTTPS_PORT=443

# Backups (a cada 24h, mantendo os últimos 14 dias)
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
